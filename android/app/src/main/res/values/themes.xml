<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Deliberately AppCompat rather than Material3: a Material theme inflates
      every <Button> as a MaterialButton, which ignores android:background and
      paints its own tint instead - so the slab drawables never appeared and
      every button came out lavender.
    -->
    <style name="Theme.BedrockAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/slab2</item>
        <item name="android:navigationBarColor">@color/void_bg</item>
        <item name="android:windowBackground">@color/void_bg</item>
        <item name="android:colorBackground">@color/void_bg</item>
        <item name="colorAccent">@color/green</item>
    </style>
</resources>
