<?xml version="1.0" encoding="utf-8"?>
<!--
  The desktop app's shape, on a phone: a header slab across the top, then
  numbered steps. Every button is a slab with a solid side under it, and every
  field is a well cut into the surface.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- header slab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slab2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add your API key"
                android:textColor="@color/ink3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- the header's own thickness -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/edge" />

    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/StepHead"
                android:text="1 · Your API key" />

            <TextView
                style="@style/StepNote"
                android:text="A free Groq key works. It is kept on this phone only." />

            <EditText
                android:id="@+id/key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/well"
                android:hint="gsk_..."
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink4"
                android:textSize="14sp" />

            <Button
                android:id="@+id/saveKey"
                style="@style/SlabGrey"
                android:text="Save key" />

            <TextView
                style="@style/StepHead"
                android:text="2 · Start the AI" />

            <Button
                android:id="@+id/start"
                style="@style/SlabGreen"
                android:text="Start AI" />

            <TextView
                style="@style/StepHead"
                android:text="3 · Add it to Minecraft" />

            <TextView
                style="@style/StepNote"
                android:text="Opens the add-on in Minecraft. Turn it on in the world you play." />

            <Button
                android:id="@+id/install"
                style="@style/SlabGrey"
                android:text="Install add-on" />

            <TextView
                style="@style/StepHead"
                android:text="4 · In Minecraft chat" />

            <TextView
                android:id="@+id/command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/well"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:text="/connect localhost:8080"
                android:textColor="@color/green_lit"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <Button
                android:id="@+id/copy"
                style="@style/SlabGrey"
                android:text="Copy command" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="24dp"
                android:text="Leave this app running while you play. Not an official Minecraft product."
                android:textColor="@color/ink4"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
