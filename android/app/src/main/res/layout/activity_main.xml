<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C0E"
    android:fitsSystemWindows="true">

    <!-- once the bridge is up this shows the same page the desktop app does -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#EEF0F3"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Add your API key"
                android:textColor="#A4ABB6"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="1. Your API key"
                android:textColor="#EEF0F3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="A free Groq key works. It is stored on this phone only."
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#141519"
                android:hint="gsk_..."
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="#EEF0F3"
                android:textColorHint="#4A5058"
                android:textSize="14sp" />

            <Button
                android:id="@+id/saveKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2A2D34"
                android:text="Save key"
                android:textColor="#EEF0F3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="2. Start the AI"
                android:textColor="#EEF0F3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#43C94B"
                android:text="Start AI"
                android:textColor="#0C1A0D"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="3. Add it to Minecraft"
                android:textColor="#EEF0F3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/install"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2A2D34"
                android:text="Install add-on"
                android:textColor="#EEF0F3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="4. In Minecraft chat"
                android:textColor="#EEF0F3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#141519"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:text="/connect localhost:8080"
                android:textColor="#6BE070"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <Button
                android:id="@+id/copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2A2D34"
                android:text="Copy command"
                android:textColor="#EEF0F3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:text="Keep this app running in the background while you play. Not an official Minecraft product."
                android:textColor="#4A5058"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
