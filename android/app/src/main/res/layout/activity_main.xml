<?xml version="1.0" encoding="utf-8"?>
<!--
  The desktop app's shape on a phone: a header slab, then the steps. Buttons
  are slabs with a solid side under them, fields are wells cut into the surface.

  Wording is kept to what a first-time player has to know. Anything longer -
  the conversation - sits behind a button rather than stretching the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slab2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Add your API key"
                android:textColor="@color/ink3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/edge" />

    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="18dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/StepHead"
                android:layout_marginTop="0dp"
                android:text="1 · Which AI" />

            <Spinner
                android:id="@+id/provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/well"
                android:padding="14dp"
                android:popupBackground="@color/slab2" />

            <TextView
                android:id="@+id/keyHint"
                style="@style/StepNote"
                android:layout_marginTop="12dp"
                android:text="Key from console.groq.com/keys" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/key"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/well"
                    android:hint="Paste key"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink4"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/reveal"
                    style="@style/SlabGrey"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:minWidth="72dp"
                    android:paddingHorizontal="10dp"
                    android:text="Show"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/saveKey"
                style="@style/SlabGrey"
                android:text="Save key" />

            <TextView
                style="@style/StepHead"
                android:text="2 · The AI" />

            <Button
                android:id="@+id/start"
                style="@style/SlabGreen"
                android:text="Start AI" />

            <TextView
                style="@style/StepHead"
                android:text="3 · Add to Minecraft" />

            <Button
                android:id="@+id/install"
                style="@style/SlabGrey"
                android:text="Install add-on" />

            <TextView
                style="@style/StepHead"
                android:text="4 · In Minecraft chat" />

            <TextView
                style="@style/StepNote"
                android:text="No cheats? Type  connect ai  in chat instead." />

            <TextView
                android:id="@+id/command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/well"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:text="/connect localhost:8080"
                android:textColor="@color/green_lit"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <Button
                android:id="@+id/copy"
                style="@style/SlabGrey"
                android:text="Copy command" />

            <Button
                android:id="@+id/openChat"
                style="@style/SlabGrey"
                android:layout_marginTop="26dp"
                android:text="Conversation" />

            <Button
                android:id="@+id/kofi"
                style="@style/SlabKofi"
                android:text="Support on Ko-fi" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:text="By VoxenMC2\nNot an official Minecraft product."
                android:textColor="@color/ink4"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
